PUID=1000
PGID=1000
TZ=Europe/London
UMASK=002

# Service-specific credentials. These names are intentionally scoped so they
# cannot collide with normal shell variables such as USERNAME.
SONARR_USERNAME=admin
SONARR_PASSWORD=CHANGE_THIS_SONARR_PASSWORD
RADARR_USERNAME=admin
RADARR_PASSWORD=CHANGE_THIS_RADARR_PASSWORD
PROWLARR_USERNAME=admin
PROWLARR_PASSWORD=CHANGE_THIS_PROWLARR_PASSWORD
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=CHANGE_THIS_QBITTORRENT_PASSWORD

# Private Internet Access (PIA) OpenVPN credentials. These are the only
# subscription/account-specific values this project cannot fill in for you.
# Use the PIA OpenVPN username/password from your PIA account, which may differ
# from the credentials used to sign in to the PIA website/app.
PIA_OPENVPN_USER=CHANGE_THIS_PIA_OPENVPN_USER
PIA_OPENVPN_PASSWORD=CHANGE_THIS_PIA_OPENVPN_PASSWORD
PIA_OPENVPN_PROTOCOL=udp

# Optional comma-separated Gluetun PIA region filter. Blank lets Gluetun choose.
# With port forwarding enabled, PORT_FORWARD_ONLY=true restricts selection to
# compatible PIA servers.
PIA_SERVER_REGIONS=
PIA_PORT_FORWARD_ONLY=true
PIA_VPN_PORT_FORWARDING=on

# Sonarr/Radarr reach qBittorrent via Gluetun because qBittorrent shares
# Gluetun's network namespace.
QBITTORRENT_HOST=gluetun
QBITTORRENT_WEBUI_PORT=8080

QBITTORRENT_SAVE_PATH=/data/downloads
QBITTORRENT_TEMP_PATH=/data/downloads/incomplete
QBITTORRENT_SONARR_CATEGORY=sonarr
QBITTORRENT_SONARR_CATEGORY_PATH=/data/downloads/tv
QBITTORRENT_RADARR_CATEGORY=radarr
QBITTORRENT_RADARR_CATEGORY_PATH=/data/downloads/movies
QBITTORRENT_TORRENT_PORT=6881

# Bootstrap/readiness timeouts. All waits are bounded and print service logs on
# failure instead of hanging forever.
STACK_STARTUP_TIMEOUT_SECONDS=180
STACK_SERVICE_WAIT_SECONDS=120
QBITTORRENT_TEMP_PASSWORD_WAIT_SECONDS=60

# If coordinator authentication is genuinely rejected, wait a long time before
# trying again so a bad password cannot rapidly trigger qBittorrent's IP ban.
QBITTORRENT_AUTH_RETRY_SECONDS=300

# FileSecurityManager is port 8080 inside Compose. qBittorrent already uses
# host port 8080, so FileSecurityManager is exposed only on localhost:8081.
FILE_SECURITY_HOST_PORT=8081
FILE_SECURITY_SAFE_STATES=SAFE

# Optional comma-separated terminal rejection states if your FileSecurityManager
# configuration exposes them. Leaving this blank is fail-closed: anything not
# SAFE simply remains blocked from Sonarr/Radarr import.
FILE_SECURITY_BLOCK_STATES=

# copy lets Sonarr/Radarr keep qBittorrent downloads in place for seeding.
# With hardlinks enabled and downloads/media on the same filesystem, the apps
# can hardlink into their libraries rather than duplicate bytes.
SONARR_IMPORT_MODE=copy
RADARR_IMPORT_MODE=copy

COORDINATOR_POLL_INTERVAL_SECONDS=10
COORDINATOR_HTTP_TIMEOUT_SECONDS=20
COORDINATOR_DRY_RUN=false
